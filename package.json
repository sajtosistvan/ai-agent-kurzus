{
  "name": "@plantbase/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "postinstall": "prisma generate --schema=packages/db/prisma/schema.prisma",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cli:build": "nx build cli",
    "cli": "tsx --conditions=@plantbase/source apps/cli/src/main.ts",
    "server": "tsx --conditions=@plantbase/source apps/server/src/main.ts",
    "mcp": "tsx --conditions=@plantbase/source apps/mcp/src/main.ts",
    "mcp:http": "tsx --conditions=@plantbase/source apps/mcp/src/http.ts",
    "mcp:inspect": "CLIENT_PORT=6280 SERVER_PORT=6281 npx -y @modelcontextprotocol/inspector@2.0.0 pnpm mcp",
    "mcp:mcpjam": "npx -y @mcpjam/inspector@2.30.0",
    "mcp:smoke": "tsx --conditions=@plantbase/source apps/mcp/src/smoke.ts",
    "mcp:mcpb": "npx -y @anthropic-ai/mcpb@2.1.2 pack apps/mcp/mcpb dist/plantbase.mcpb",
    "web": "nx dev web",
    "mastra:dev": "pnpm --filter @plantbase/core exec mastra dev --dir src/mastra --env ../../.env",
    "mastra:build": "pnpm --filter @plantbase/core exec mastra build --dir src/mastra",
    "db:generate": "prisma generate --schema=packages/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=packages/db/prisma/schema.prisma",
    "db:reset": "prisma migrate reset --schema=packages/db/prisma/schema.prisma",
    "db:seed": "prisma db seed",
    "knowledge:ingest": "tsx --conditions=@plantbase/source apps/cli/src/ingest-knowledge.ts",
    "db:studio": "prisma studio --schema=packages/db/prisma/schema.prisma",
    "demo": "bash scripts/demo.sh",
    "redteam:owasp": "CI=true npx -y promptfoo@latest redteam run --config redteam/owasp-demo.yaml --env-file .env --output tmp/owasp-demo.json --force",
    "redteam:report": "npx -y promptfoo@latest redteam report"
  },
  "private": true,
  "prisma": {
    "seed": "tsx packages/db/prisma/seed.ts"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "3.0.93",
    "@eslint/js": "^9.8.0",
    "@nx/esbuild": "23.0.1",
    "@nx/eslint": "23.0.1",
    "@nx/eslint-plugin": "23.0.1",
    "@nx/js": "23.0.1",
    "@nx/node": "23.0.1",
    "@nx/vite": "23.0.1",
    "@nx/vitest": "23.0.1",
    "@nx/web": "23.0.1",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "~4.1.0",
    "ai": "6.0.219",
    "esbuild": "^0.27.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jiti": "2.4.2",
    "jsonc-eslint-parser": "^2.1.0",
    "mastra": "^1.21.0",
    "nx": "23.0.1",
    "playwright": "^1.61.1",
    "prettier": "^3.8.1",
    "prisma": "^6",
    "tslib": "^2.3.0",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.40.0",
    "vite": "^8.0.0",
    "vitest": "~4.1.0"
  },
  "dependencies": {
    "@prisma/client": "^6"
  }
}
